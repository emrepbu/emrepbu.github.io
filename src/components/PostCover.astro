---
import Cover from '@/components/Cover.astro'
import { getCoverAnimation } from '@/lib/cover-animation'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  variant?: 'detail' | 'card'
}

const { post, variant = 'detail' } = Astro.props
---

<Cover
  title={post.data.title}
  animation={getCoverAnimation(post)}
  image={post.data.image}
  variant={variant}
/>
